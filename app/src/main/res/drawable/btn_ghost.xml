<?xml version="1.0" encoding="utf-8"?>
<!-- Pille nach Design-System §6 "Einstellungen": PANEL_BG, Messing-Rahmen (~90 %);
     gedrueckt Rahmen voll + TOUR_BG; deaktiviert Rahmen ~40 %. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/rr_panel_bg" />
            <stroke android:width="1.5dp" android:color="#66CBA36B" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rr_tour_bg" />
            <stroke android:width="1.5dp" android:color="@color/rr_brass" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rr_panel_bg" />
            <stroke android:width="1.5dp" android:color="#E6CBA36B" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
