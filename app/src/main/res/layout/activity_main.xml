<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/statusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_initial"
        android:textSize="16sp"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/retryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/retry_button" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/loadGpxButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gpx_load_button" />

        <Button
            android:id="@+id/routeToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/route_start" />
    </LinearLayout>

    <TextView
        android:id="@+id/routeInfoView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textSize="14sp"
        android:text="@string/route_none" />

    <TextView
        android:id="@+id/bleStatusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:textSize="16sp"
        android:text="@string/ble_status_initial" />

    <TextView
        android:id="@+id/navStateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:text="@string/navstate_initial" />

    <TextView
        android:id="@+id/positionStateView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:text="@string/position_initial" />

</LinearLayout>
