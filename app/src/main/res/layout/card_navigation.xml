<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation: Distanz-Ring wie auf dem Navigationsscreen des BikeComputers. Geteilt von MainActivity und NaviActivity (LiveCards). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/TB.Card">

    <TextView
        style="@style/TB.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/card_navigation" />

    <LinearLayout
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="152dp"
            android:layout_height="152dp">

            <com.euphi.trailbridge.GappedArcView
                android:id="@+id/navArc"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/navArrow"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_arrow"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/navDistView"
                    style="@style/TB.Number.Hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/dash"
                    android:textSize="40sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/navManeuverView"
                style="@style/TB.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_none" />

            <TextView
                android:id="@+id/navStreetView"
                style="@style/TB.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:maxLines="3"
                android:textColor="@color/rr_parchment_bright"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/navThenView"
                style="@style/TB.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/navRemainView"
                style="@style/TB.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
